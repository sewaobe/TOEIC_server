@startuml
skinparam backgroundColor #1e1e1e
skinparam participantBackgroundColor #2b2b2b
skinparam participantBorderColor #888
skinparam participantFontColor white
skinparam sequenceArrowColor #00ffff
actor User
participant "Router" as R
participant "Auth.controller" as C
participant "Auth.service" as S
participant "UserModel" as MUserModel
participant "RoleModel" as MRoleModel
participant "Hash" as UHash
participant "Jwt" as UJwt
participant "Firebase" as UFirebase
participant "Firebase" as F

'=== POST /login ===
User -> R: POST /login
R -> C: validateSchema()
note right of C: Không tìm thấy thân hàm validateSchema
S -> MUser: findOne()
MUser --> S: result
S -> MRole: findOne()
MRole --> S: result
S -> MUser: create()
MUser --> S: result
S -> F: verifyIdToken()
F --> S: decoded user
note right of F: Firebase xác thực ID Token
S --> C: response
C --> R: JSON
R --> User: HTTP POST /login response

'=== POST /google ===
User -> R: POST /google
R -> C: loginWithGoogleController()
C -> S: loginWithGoogleService()
note right of C: Controller gọi loginWithGoogleService để xử lý logic loginWithGoogle
S -> MUser: findOne()
MUser --> S: result
S -> MRole: findOne()
MRole --> S: result
S -> MUser: create()
MUser --> S: result
S -> F: verifyIdToken()
F --> S: decoded user
note right of F: Firebase xác thực ID Token
S --> C: response
C --> R: JSON
