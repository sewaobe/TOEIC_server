@startuml
skinparam backgroundColor #1e1e1e
skinparam participantBackgroundColor #2b2b2b
skinparam participantBorderColor #888
skinparam participantFontColor white
skinparam sequenceArrowColor #00ffff
actor User
participant "Router" as R
participant "FlashCard.controller" as C
participant "FlashCard.service" as S

'=== GET /history/:topicId ===
User -> R: GET /history/:topicId
R -> C: getHistoryFlashCardByTopic()
note right of C: Không tìm thấy thân hàm getHistoryFlashCardByTopic
S -> MFlashCardAttempt: create()
MFlashCardAttempt --> S: result
S --> C: response
C --> R: JSON
R --> User: HTTP GET /history/:topicId response

'=== GET /:id ===
User -> R: GET /:id
R -> C: getFlashCardById()
note right of C: Không tìm thấy thân hàm getFlashCardById
S -> MFlashCardAttempt: create()
MFlashCardAttempt --> S: result
S --> C: response
C --> R: JSON
R --> User: HTTP GET /:id response

'=== POST /submit ===
User -> R: POST /submit
R -> C: submitFlashCard()
note right of C: Không tìm thấy thân hàm submitFlashCard
S -> MFlashCardAttempt: create()
MFlashCardAttempt --> S: result
S --> C: response
C --> R: JSON
R --> User: HTTP POST /submit response

@enduml
