@startuml
skinparam backgroundColor #1e1e1e
skinparam participantBackgroundColor #2b2b2b
skinparam participantBorderColor #888
skinparam participantFontColor white
skinparam sequenceArrowColor #00ffff
actor User
participant "Router" as R
participant "Flashcard_progress.controller" as C
participant "Flashcard_progress.service" as S
participant "Flashcard_progressModel" as MFlashcard_progressModel

'=== POST /start ===
User -> R: POST /start
R -> C: createSessionFlashcardController()
note right of C: Không tìm thấy thân hàm createSessionFlashcardController
S -> MSession: save()
MSession --> S: result
S -> MFlashCardProgress: findOne()
MFlashCardProgress --> S: result
S -> MFlashCardProgress: find()
MFlashCardProgress --> S: result
S -> MFlashCardAttempt: create()
MFlashCardAttempt --> S: result
S --> C: response
C --> R: JSON
R --> User: HTTP POST /start response

'=== PATCH /update ===
User -> R: PATCH /update
R -> C: updateSessionFlashcardController()
note right of C: Không tìm thấy thân hàm updateSessionFlashcardController
S -> MSession: save()
MSession --> S: result
S -> MFlashCardProgress: findOne()
MFlashCardProgress --> S: result
S -> MFlashCardProgress: find()
MFlashCardProgress --> S: result
S -> MFlashCardAttempt: create()
MFlashCardAttempt --> S: result
S --> C: response
C --> R: JSON
R --> User: HTTP PATCH /update response

'=== GET /active-by-user ===
